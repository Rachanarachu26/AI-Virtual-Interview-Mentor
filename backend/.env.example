# ==========================================================
# AI Virtual Interview Mentor - Backend Environment Variables
# Copy this file to `.env` and fill in the real values.
# ==========================================================

# ---- Database (MySQL) ----
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_interview

# ---- JWT / Auth ----
JWT_SECRET_KEY=change_this_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Google Gemini ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# ---- Whisper (speech-to-text) ----
# tiny | base | small | medium | large
WHISPER_MODEL=base

# ---- CORS (comma separated list of allowed origins) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- Evaluation weights (must sum to 1.0) ----
WEIGHT_ANSWER_QUALITY=0.40
WEIGHT_COMMUNICATION=0.25
WEIGHT_EYE_CONTACT=0.15
WEIGHT_POSTURE=0.10
WEIGHT_GESTURE=0.10
